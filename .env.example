# Supabase (on Vercel the integration provides NEXT_PUBLIC_rtj_* instead)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://ratethatjob.com

# Server only: background jobs (translations) and machine translation
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=
# Protects /api/cron/* (Vercel sends it as a Bearer token)
CRON_SECRET=

# Google Places API (New): workplace search and one page per Google place.
# Needs SUPABASE_SECRET_KEY too (new places are saved server-side).
GOOGLE_PLACES_API_KEY=

# Email (Resend): employer messages to applicants, team invites and reminders. Without it messages stay in-app.
RESEND_API_KEY=
EMAIL_FROM="RateThatJob <no-reply@ratethatjob.com>"
# Optional: key for encrypting/hashing invite email addresses (defaults to one derived from
# SUPABASE_SECRET_KEY). Set once and keep it: changing it breaks pending reminders and unsubscribes.
INVITE_SECRET=

# Stripe (live keys only on Vercel production): Pro subscriptions and job ad payments.
# Webhook endpoint: https://ratethatjob.com/api/stripe/webhook. Without the secret key,
# Pro and job ads are paid by invoice and marked paid by an admin.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
